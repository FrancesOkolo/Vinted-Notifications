# Copy this file to .env and replace both example secrets before starting Docker.
VN_WEB_USERNAME=admin
VN_WEB_PASSWORD=replace-with-a-long-unique-password
VN_SECRET_KEY=replace-with-at-least-32-random-characters

# Required whenever RSS is enabled. RSS clients may send it as an
# Authorization: Bearer header or as the ?token= query parameter.
VN_RSS_TOKEN=replace-with-a-long-random-rss-token

# Enable secure session cookies and HSTS only after HTTPS is configured.
VN_WEB_HTTPS=false

# Optional comma-separated hostnames/IPs accepted by Flask. Include localhost
# if Docker health checks access the Web UI through that name.
VN_WEB_TRUSTED_HOSTS=

# Request limits protect the small admin forms from oversized submissions.
VN_WEB_MAX_REQUEST_BYTES=262144
VN_WEB_MAX_FORM_MEMORY_BYTES=262144
VN_WEB_MAX_FORM_PARTS=200

# Temporarily block an IP after repeated incorrect Web UI credentials.
VN_WEB_AUTH_MAX_FAILURES=10
VN_WEB_AUTH_WINDOW_SECONDS=300
VN_WEB_AUTH_BLOCK_SECONDS=900

# Ports bind only to the local host. Use an SSH tunnel or authenticated proxy.
VN_WEB_PORT=8000
VN_RSS_PORT=8080
VN_IMAGE_TAG=test
TZ=Europe/London

# Local testing while the live server polls the same Telegram bot:
# false = send notifications only; do not receive Telegram commands.
VN_TELEGRAM_POLLING=true
